{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node bin/boxglow.js hook session-start --actor claude-code"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node bin/boxglow.js hook stop --actor claude-code"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node bin/boxglow.js hook pre-tool --actor claude-code"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npx boxglow *)",
      "Bash(boxglow *)"
    ]
  },
  "enabledMcpjsonServers": [
    "boxglow"
  ]
}
