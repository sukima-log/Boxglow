{
  "name": "boxglow",
  "private": false,
  "version": "0.6.3",
  "type": "module",
  "description": "See at a glance what your AI agents and your team are working on: tasks as input/output boxes that go from BlackBox to WhiteBox. Web app + CLI, one boxglow.json in your repo.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:cli",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "bash e2e/run.sh",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "build:cli": "esbuild cli/entry.ts --bundle --loader:.md=text --platform=node --format=esm --target=node18 --external:@modelcontextprotocol/sdk --external:zod --outfile=bin/boxglow.js --banner:js='#!/usr/bin/env node'",
    "prepare": "npm run build:cli",
    "prepublishOnly": "npm run build",
    "build:pages": "tsc -b && VITE_BASE=/ vite build --outDir dist-pages && npm run build:cli && npm run build:legal",
    "deploy:pages": "npm run build:pages && npx --yes wrangler@4 pages deploy dist-pages --project-name=boxglow --commit-dirty=true",
    "waitlist:list": "npx --yes wrangler@4 kv key list --binding WAITLIST --prefix email: --remote",
    "waitlist:get": "npx --yes wrangler@4 kv key get --binding WAITLIST --remote",
    "build:vscode": "npm run build && rm -rf vscode/media && cp -r dist vscode/media && rm -rf vscode/media/waitlist && cp docs/logo/boxglow-128.png vscode/media/icon-128.png && cd vscode && npm run compile",
    "build:legal": "node scripts/build-legal.mjs --out dist-pages",
    "build:hosted": "esbuild cli/hosted.ts --bundle --loader:.md=text --platform=node --format=esm --target=es2022 --alias:node:fs=./cli/shims/node-fs.ts --alias:node:os=./cli/shims/node-os.ts --alias:node:child_process=./cli/shims/node-child_process.ts --alias:node:http=./cli/shims/node-http.ts --outfile=dist/hosted-mcp.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/common": "^1.5.3",
    "@lezer/markdown": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "^12.12.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "idb-keyval": "^6.3.0",
    "nanoid": "^6.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "license": "MIT",
  "bin": {
    "boxglow": "bin/boxglow.js"
  },
  "files": [
    "bin",
    "dist/index.html",
    "dist/assets",
    "dist/*.svg",
    "dist/*.ico",
    "dist/*.png",
    "README.md",
    "LICENSE",
    "docs/AGENTS_SNIPPET.md",
    "examples"
  ],
  "keywords": [
    "task-management",
    "ai-agents",
    "claude-code",
    "codex",
    "visualization",
    "project-planning",
    "roadmap",
    "git"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sukima-log/Boxglow.git"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/sukima-log/Boxglow#readme",
  "bugs": {
    "url": "https://github.com/sukima-log/Boxglow/issues"
  },
  "author": "sukima-log"
}
